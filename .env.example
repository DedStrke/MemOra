# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored - NEVER commit real keys.
# Everything else in this app works with no keys at all (it's a fully
# on-device, no-backend tool). This is only needed for the optional
# "Generate with AI" flashcard deck builder on the Flashcards page.

# Used client-side, so it ships in the bundle and is effectively public:
# treat it as such and rotate if leaked.
# Get a key from https://console.mistral.ai/ (API Keys).
VITE_MISTRAL_API_KEY=your-mistral-api-key
VITE_MISTRAL_MODEL=mistral-large-latest

# Optional: lets the corner music player list YOUR Spotify playlists after
# a "Connect Spotify" login (PKCE, no secret). Create an app at
# https://developer.spotify.com/dashboard, add these redirect URIs -
#   https://memoraa.web.app/   and   http://localhost:5173/
# - and paste its client id here. Without it the player still works: sign
# in to Spotify in the browser and paste any playlist link.
VITE_SPOTIFY_CLIENT_ID=
