# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored - NEVER commit real keys.
# Get these from: Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Firebase (web app config). These are PUBLIC project identifiers - safe to
# expose in client code; kept in env only to follow repo convention.
# Get them from: Firebase Console -> Project settings -> Your apps -> SDK setup.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Sparky chatbot (Google Gemini). Used client-side, so it ships in the bundle
# and is effectively public: treat it as such and rotate if leaked. Get a key
# from Google AI Studio (https://aistudio.google.com/app/apikey).
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_GEMINI_MODEL=gemini-2.0-flash
